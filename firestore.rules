rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Exige uma sessão autenticada antes de consultar dados do aplicativo.
    function signedIn() {
      return request.auth != null;
    }

    // O papel de administrador vem do perfil controlado no Firebase Console.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Usuários só podem criar o próprio perfil comum; nenhum cliente pode trocar papéis.
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt']);
      allow update: if signedIn()
        && (request.auth.uid == userId || isAdmin())
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt']);
      // Contas e papéis são administrados pelo Firebase Console, não pelo navegador.
      allow delete: if false;
    }

    // Produtos podem ser vistos por usuários autenticados e alterados por administradores.
    match /items/{itemId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['nome', 'desc', 'photoUrl', 'photoPath']);
      allow delete: if isAdmin();
    }

    // Cada usuário consulta seus empréstimos; apenas administradores alteram seu andamento.
    match /loans/{loanId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'itemId', 'userId', 'nome', 'contato', 'devolucao',
          'codigo', 'codigoEntrega', 'status', 'criado'
        ])
        && request.resource.data.keys().hasOnly([
          'itemId', 'userId', 'nome', 'contato', 'devolucao',
          'codigo', 'codigoEntrega', 'status', 'criado'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'reservado'
        && request.resource.data.itemId is string
        && request.resource.data.itemId.size() > 0
        && request.resource.data.itemId.size() <= 128
        && exists(/databases/$(database)/documents/items/$(request.resource.data.itemId))
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.nome == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 120
        && request.resource.data.contato == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email
        && request.resource.data.contato is string
        && request.resource.data.contato.size() <= 254
        && request.resource.data.devolucao is string
        && request.resource.data.devolucao.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.criado is string
        && request.resource.data.criado.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.codigo is string
        && request.resource.data.codigo.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.codigoEntrega is string
        && request.resource.data.codigoEntrega.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.codigo != request.resource.data.codigoEntrega;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Configurações globais só podem ser alteradas por administradores.
    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin() && settingId == 'app';
    }
  }
}
